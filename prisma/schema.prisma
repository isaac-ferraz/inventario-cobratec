// Schema do Sistema de Inventário de Hardware (Cobratec TI)
// SQLite é a fonte única de verdade. O Excel é apenas relatório de saída.

generator client {
  provider = "prisma-client-js"
  // "native" cobre o ambiente local; o target musl cobre a imagem Alpine do Docker.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Sala = espaço físico do escritório (ex: "Sala 93 — piso superior"). É um
// catálogo EDITÁVEL pela UI, no mesmo espírito do TipoComponente: o TI cadastra
// salas novas sem mexer no código. Liga-se ao computador (onde a máquina está) e
// ao funcionário (onde a pessoa senta). Celular não tem sala: o aparelho anda
// com o dono. Ver /docs/decisoes.md.
model Sala {
  id           String        @id @default(cuid())
  nome         String        @unique // "Sala 93 — piso superior"
  predio       String? // "93", "83"... texto livre
  piso         String? // "superior", "inferior", "térreo"... texto livre
  ordem        Int           @default(0) // ordem de exibição nas listas
  ativa        Boolean       @default(true) // sala desativada some dos seletores
  observacoes  String?
  computadores Computador[]
  funcionarios Funcionario[]
  chamados     Chamado[]
  supervisores SupervisorSala[]
  criadoEm     DateTime      @default(now())
}

// Quem responde por uma sala. Tabela de ligação explícita (e não relação
// implícita do Prisma) por dois motivos: uma sala tem QUANTOS supervisores
// precisar e um supervisor pode responder por mais de uma sala; e `criadoEm`
// registra desde quando, que é o tipo de pergunta que aparece depois.
model SupervisorSala {
  id         String   @id @default(cuid())
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  salaId     String
  sala       Sala     @relation(fields: [salaId], references: [id], onDelete: Cascade)
  criadoEm   DateTime @default(now())

  // Uma pessoa não supervisiona a mesma sala duas vezes.
  @@unique([usuarioId, salaId])
  @@index([usuarioId])
  @@index([salaId])
}

// Usuário = quem ENTRA no sistema. Tabela separada do Funcionario de propósito:
// o funcionário é um registro de inventário (dono de equipamento, com as
// credenciais Siscobra/Vonix guardadas como cofre); o usuário é acesso ao app.
// Nem todo funcionário precisa de login, e o TI pode ter login sem estar no
// inventário. O vínculo é opcional, para o chamado saber de quem é o posto.
//
// papel:
//   "ADMIN"      — acesso total ao sistema.
//   "SUPERVISOR" — responde por uma ou mais salas: vê e edita o que está nelas
//                  (equipamentos, pessoas, chamados), inclusive o cofre de
//                  senhas da própria equipe. Não alcança nada fora das salas
//                  dele, nem as telas globais (usuários, tipos, auditoria).
//   "OPERADOR"   — só abre e acompanha os próprios chamados.
// Guardado como String, no mesmo espírito de `cargo`/`categoria` — o SQLite não
// tem enum nativo e a lista é curta e estável.
model Usuario {
  id             String       @id @default(cuid())
  login          String       @unique
  nome           String
  // Hash scrypt no formato "scrypt$N$salt$hash" — ver lib/senha.ts. Diferente
  // das senhas do cofre (Siscobra/Vonix/PC), que são texto puro por precisarem
  // ser LIDAS de volta; esta aqui só precisa ser comparada.
  senhaHash      String
  papel          String       @default("OPERADOR")
  ativo          Boolean      @default(true)
  // Marca a senha inicial gerada pelo seed: a UI cobra a troca até ser mudada.
  senhaProvisoria Boolean     @default(false)
  funcionarioId  String?
  funcionario    Funcionario? @relation(fields: [funcionarioId], references: [id])
  // `usuario.usucod` da operadora no Siscobra (CRM de cobrança). Só faz sentido
  // para o papel COBRANCA, e sem ele não há como atribuir uma conversa a quem
  // de fato trabalhou o caso nem medir conversão — as regras de atribuição do
  // Siscobra (acionamento e acordo) são todas por `usucod`.
  //
  // É Int e não relação: o Siscobra é outro banco, PostgreSQL e SOMENTE
  // LEITURA. Guardar o código solto é o único vínculo possível, e por isso ele
  // pode apontar para um operador que não existe mais lá — quem consome trata
  // o vazio, em vez de o SQLite prometer uma integridade que não pode cumprir.
  siscobraUsucod Int?
  criadoEm       DateTime     @default(now())
  ultimoAcessoEm DateTime?

  chamadosAbertos    Chamado[]         @relation("solicitante")
  chamadosAtribuidos Chamado[]         @relation("responsavel")
  mensagens          ChamadoMensagem[]
  // Salas pelas quais responde. Só faz sentido com papel SUPERVISOR; para os
  // outros papéis a lista fica vazia.
  supervisoes        SupervisorSala[]
  // Conversas com devedor que assumiu. Só faz sentido com papel COBRANCA.
  conversas          Conversa[]
  respostas          ConversaMensagem[]

  @@index([funcionarioId])
}

// ─────────────────────── Conversas com devedor (cobrança) ───────────────────
//
// O atendimento por WhatsApp ao devedor. Duas coisas que este modelo NÃO é, e
// que explicam o resto do desenho:
//
// 1. Não é o estado do robô. Quem orquestra a conversa é o n8n (classificar,
//    consultar o Siscobra, decidir responder ou escalar). O que mora aqui é o
//    REGISTRO do atendimento: o que a operadora precisa ver para assumir, e o
//    que a empresa precisa conseguir provar depois — cobrança é área regulada
//    (CDC art. 42 e 71), e "o que foi dito ao devedor" é a pergunta que aparece.
//
// 2. Não é espelho do Siscobra. O CRM não guarda mensagem de WhatsApp
//    (confirmado no mapa do schema), então este é o único lugar onde a conversa
//    existe. O vínculo com o CRM é por código solto, como em `siscobraUsucod`
//    (decisão 27): outro banco, PostgreSQL, somente leitura.
model Conversa {
  id String @id @default(cuid())

  // Identidade da conversa é o TELEFONE, não o devedor: ela começa antes de
  // saber quem é (e pode nunca chegar lá — engano, ex-devedor, terceiro).
  // Só dígitos em E.164, sem "+" nem máscara: "5512997654321".
  telefone String  @unique
  // Nome que o WhatsApp anuncia (pushName). NÃO é identificação — qualquer um
  // escreve o que quiser aí. Serve só para a fila não ficar com números secos.
  nome     String?

  // Preenchidos quando o devedor confirma CPF **e** data de nascimento — a
  // dupla verificação anti-enumeração que o "Negocie Online" já usa. Sem isso o
  // robô não diz um único valor: é a regra de ouro do domínio.
  siscobraDevcod Int?
  siscobraCarcod Int?
  // Nome da carteira congelado no momento da identificação, para a fila não
  // precisar consultar o CRM só para desenhar a lista.
  carteira       String?
  identificadaEm DateTime?

  // bot        — o robô está conduzindo.
  // fila       — pediu humano (ou o robô desistiu) e ninguém assumiu ainda.
  // humana     — uma operadora assumiu; o robô cala nesta conversa.
  // encerrada  — acabou.
  // String pelo mesmo motivo de `papel` e `status` do chamado.
  situacao String @default("bot")
  // Por que saiu do robô — "pediu_humano", "fora_da_regra", "irritado"... Texto
  // livre porque quem classifica é o n8n, e engessar aqui obrigaria migration a
  // cada motivo novo que o prompt aprender.
  motivoEscalonamento String?

  // Operadora que assumiu. `SetNull`: a conversa sobrevive ao desligamento de
  // quem a atendeu — e continua sendo prova do que foi dito.
  responsavelId String?
  responsavel   Usuario? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  // Dossiê do Siscobra (saldo, contratos, regra de parcelamento da carteira),
  // como JSON serializado — mesmo padrão de `Componente.especificacoes`.
  //
  // É um SNAPSHOT empurrado pelo n8n, e não uma consulta que este app faz: o
  // inventário não abre conexão com o Siscobra (ver decisão 28). Congelado tem
  // valor próprio — é o que a operadora tinha à frente quando negociou.
  dossie   String?
  dossieEm DateTime?

  // ── memória do robô entre uma mensagem e a seguinte (decisão 32) ──
  //
  // Sem isto o robô recomeçaria a cada fala: pediria CPF de novo depois de já
  // ter recebido, e ofereceria o acordo outra vez para quem acabou de recusar.
  // É o que torna a conversa uma conversa, e não um formulário reiniciado.
  //
  // `saldo`/`vencidoDesde` ficam CONGELADOS na identificação de propósito: a
  // resposta que o devedor leu não pode mudar no meio da conversa porque uma
  // baixa entrou no CRM entre duas mensagens — o que ele viu foi o que valia,
  // e é isso que a operadora precisa enxergar ao assumir.
  cpfPendente        String? // só dígitos, apagado assim que a identificação fecha
  nascimentoPendente String? // AAAA-MM-DD, idem
  saldo              Float?
  vencidoDesde       String? // já formatado DD/MM/AAAA, como veio do Siscobra
  ofertou            Boolean @default(false)

  criadoEm         DateTime  @default(now())
  ultimaMensagemEm DateTime  @default(now())
  encerradaEm      DateTime?

  mensagens ConversaMensagem[]

  // A fila ordena por situação + última mensagem; o resto é lookup por dono.
  @@index([situacao, ultimaMensagemEm])
  @@index([responsavelId])
  @@index([siscobraDevcod])
}

// Uma mensagem da conversa. Append-only: mensagem enviada ao devedor não se
// edita nem se apaga — é registro de cobrança.
model ConversaMensagem {
  id        String   @id @default(cuid())
  conversaId String
  conversa  Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  // devedor | bot | operadora | sistema
  // "sistema" são os marcos do atendimento (assumiu, encerrou), que aparecem na
  // thread como no helpdesk.
  autor String

  // Quem escreveu, quando foi gente. Null para devedor, bot e sistema.
  autorId String?
  usuario Usuario? @relation(fields: [autorId], references: [id], onDelete: SetNull)

  corpo String

  // Id da mensagem no gateway de WhatsApp. UNIQUE porque webhook reentrega:
  // sem esta trava, uma reentrega do n8n duplicaria a fala do devedor no
  // histórico. É a idempotência do canal, e ela precisa estar no banco — dois
  // webhooks simultâneos passariam por um "já existe?" feito em código.
  waId String? @unique

  // Anexo do devedor (áudio, foto, comprovante). O ARQUIVO não fica no banco:
  // `midiaArquivo` é o nome do arquivo dentro da pasta de mídia (volume do
  // container, ao lado do dev.db), servido por rota autenticada.
  //
  // Fora do banco porque SQLite com blob de áudio vira um arquivo de gigabytes
  // que o backup copia inteiro toda noite — e porque o dado sensível aqui é a
  // CONVERSA; o anexo é acessório e pode ser purgado sem perder o histórico.
  //
  // `midiaTipo` é o substantivo que a operadora lê ("áudio", "imagem"). Ele é
  // preenchido mesmo quando o download falha: assim a mensagem existe na thread
  // como "[áudio]" em vez de sumir — devedor invisível é o pior defeito deste
  // módulo.
  midiaTipo    String?
  midiaMime    String?
  midiaArquivo String?
  midiaBytes   Int?

  criadoEm DateTime @default(now())

  @@index([conversaId, criadoEm])
  @@index([autorId])
}

// Chamado = pedido de suporte ao TI. É a única coisa que o OPERADOR faz no
// sistema; o admin recebe, assume, responde e fecha.
//
// status:     aberto | em_andamento | aguardando | resolvido | fechado
// prioridade: baixa | normal | alta | urgente
// Guardados como String pelo mesmo motivo de `papel` e `cargo`: SQLite não tem
// enum nativo e a lista é curta e estável.
model Chamado {
  id     String @id @default(cuid())
  // Número curto para as pessoas se referirem ao chamado ("o #12"). O SQLite só
  // aceita autoincrement na PK, então é calculado como max+1 dentro da
  // transação de criação (escrita serializada; volume de um escritório).
  numero Int    @unique

  titulo     String
  descricao  String
  categoria  String? // texto livre com sugestões na UI
  prioridade String  @default("normal")
  status     String  @default("aberto")

  // Quem pediu. Sempre vem da sessão, nunca do corpo da requisição.
  solicitanteId String
  solicitante   Usuario @relation("solicitante", fields: [solicitanteId], references: [id])
  // Admin que assumiu (opcional: chamado pode estar sem dono ainda).
  responsavelId String?
  responsavel   Usuario? @relation("responsavel", fields: [responsavelId], references: [id])

  // Contexto do problema — todos opcionais. `onDelete: SetNull` porque o
  // histórico do chamado deve sobreviver ao descarte do equipamento.
  computadorId String?
  computador   Computador? @relation(fields: [computadorId], references: [id], onDelete: SetNull)
  celularId    String?
  celular      Celular?    @relation(fields: [celularId], references: [id], onDelete: SetNull)
  salaId       String?
  sala         Sala?       @relation(fields: [salaId], references: [id], onDelete: SetNull)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  resolvidoEm  DateTime?

  mensagens   ChamadoMensagem[]
  manutencoes Manutencao[]

  @@index([status])
  @@index([solicitanteId])
  @@index([responsavelId])
  @@index([criadoEm])
}

// Andamento do chamado. `interna = true` marca nota do TI: aparece só para
// administradores e é filtrada na API antes de sair — o operador nunca a recebe.
model ChamadoMensagem {
  id        String   @id @default(cuid())
  chamadoId String
  chamado   Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  autorId   String
  autor     Usuario  @relation(fields: [autorId], references: [id])
  corpo     String
  interna   Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([chamadoId, criadoEm])
  @@index([autorId])
}

// Funcionário = a pessoa dona do computador (operadora, gestor, supervisor, etc.)
model Funcionario {
  id            String       @id @default(cuid())
  nome          String
  cargo         String // texto livre p/ não engessar a lista de cargos
  ativo         Boolean      @default(true)
  salaId        String? // onde a pessoa senta (null = sem sala definida)
  sala          Sala?        @relation(fields: [salaId], references: [id])
  // Credenciais dos sistemas usados pelo funcionário (substituem a matrícula).
  loginSiscobra String? // login do funcionário no sistema Siscobra
  senhaSiscobra String? // senha do funcionário no Siscobra
  loginVonix    String? // login do funcionário no Vonix
  senhaVonix    String? // senha do funcionário no Vonix
  computadores  Computador[]
  celulares     Celular[]
  usuarios      Usuario[]
  criadoEm      DateTime     @default(now())

  // SQLite não cria índice de FK automaticamente; ajuda o filtro por sala.
  @@index([salaId])
}

// Celular = aparelho corporativo. Igual ao Computador, pertence a um funcionário
// (ou fica em estoque com funcionarioId null) e pode ser movido entre eles.
// Não tem componentes/hardware — campos próprios de telefonia.
model Celular {
  id            String       @id @default(cuid())
  identificador String       @unique // patrimônio, etiqueta ou IMEI
  apelido       String? // modelo, ex: "Samsung Galaxy A14"
  numero        String? // número da linha, ex: "(11) 99999-0000"
  operadora     String? // Vivo, Claro, Tim... texto livre
  imei          String? // IMEI do aparelho
  observacoes   String?
  // --- Ciclo de vida do ativo (decisão 21) ---
  // `situacao` é o estado do EQUIPAMENTO, independente de ter dono: uma máquina
  // pode estar em manutenção e continuar atribuída a alguém.
  // ativo | manutencao | reserva | descartado
  situacao      String       @default("ativo")
  dataAquisicao DateTime?
  notaFiscal    String?
  garantiaAte   DateTime?
  valorCompra   Float?
  funcionarioId String?
  funcionario   Funcionario? @relation(fields: [funcionarioId], references: [id])
  chamados      Chamado[]
  manutencoes   Manutencao[]
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  // SQLite não cria índice de FK automaticamente; ajuda os filtros por dono.
  @@index([funcionarioId])
  @@index([situacao])
}

model Computador {
  id            String       @id @default(cuid())
  identificador String       @unique // patrimônio, hostname ou etiqueta
  apelido       String?
  observacoes   String?
  // Login/licenças/conta da máquina — opcionais (nem todo PC tem tudo registrado)
  loginPadrao      String? // login padrão do computador, ex: "COB-1024"
  senha            String? // senha de acesso do computador
  licencaWindows   String? // chave/observação da licença do Windows
  licencaMicrosoft String? // licença Microsoft 365 / Office
  contaOutlook     String? // conta do Outlook corporativo (e-mail)
  // Periféricos: apenas presença (sem modelo). Mouse/teclado normalmente vêm
  // com a máquina; headset é o que mais varia.
  temMouse   Boolean @default(true)
  temTeclado Boolean @default(true)
  temHeadset Boolean @default(false)

  // --- Ciclo de vida do ativo (decisão 21) ---
  // `situacao` é o estado do EQUIPAMENTO, independente de ter dono: uma máquina
  // pode estar em manutenção e continuar atribuída a alguém.
  // ativo | manutencao | reserva | descartado
  situacao      String       @default("ativo")
  dataAquisicao DateTime?
  notaFiscal    String?
  garantiaAte   DateTime?
  valorCompra   Float?
  funcionarioId String?
  funcionario   Funcionario? @relation(fields: [funcionarioId], references: [id])
  // Onde a máquina está fisicamente. Independe do dono: um PC em estoque
  // continua ocupando uma sala.
  salaId        String?
  sala          Sala?        @relation(fields: [salaId], references: [id])
  componentes   Componente[]
  chamados      Chamado[]
  manutencoes   Manutencao[]
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  // SQLite não cria índice de FK automaticamente; ajuda os filtros por dono/sala.
  @@index([funcionarioId])
  @@index([salaId])
  @@index([situacao])
}

// Item do depósito = suprimento avulso guardado em caixas (cabos, mouses,
// adaptadores, pilhas, etc.). É um controle de ESTOQUE por quantidade — quanto
// se tem de cada item e o que está em falta. Independente de computador/celular.
model ItemDeposito {
  id               String   @id @default(cuid())
  nome             String // ex: "Cabo HDMI 2m", "Mouse USB"
  categoria        String? // texto livre p/ não engessar: "Cabos", "Periféricos"...
  quantidade       Int      @default(0) // quantas unidades existem
  quantidadeMinima Int      @default(0) // alerta de estoque baixo (0 = sem alerta)
  localizacao      String? // onde está guardado, ex: "Caixa 3", "Prateleira A"
  observacoes      String?
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  @@index([categoria])
}

// Manutenção = uma ida do equipamento para conserto ou revisão. É um EVENTO com
// começo e fim, não um estado — o estado fica em `Computador.situacao` /
// `Celular.situacao`. Separar os dois permite ter histórico ("já foi 3 vezes
// para o conserto") sem perder a leitura rápida de onde a máquina está hoje.
model Manutencao {
  id           String      @id @default(cuid())
  // Um dos dois é preenchido (computador OU celular). A API valida isso; o
  // SQLite não tem CHECK constraint expressável no Prisma.
  computadorId String?
  computador   Computador? @relation(fields: [computadorId], references: [id], onDelete: Cascade)
  celularId    String?
  celular      Celular?    @relation(fields: [celularId], references: [id], onDelete: Cascade)

  tipo        String // "corretiva" (quebrou) | "preventiva" (revisão)
  descricao   String
  fornecedor  String? // assistência técnica, loja...
  custo       Float?
  // Chamado que originou o conserto, quando veio de um. Fecha o ciclo
  // suporte → manutenção. SetNull: a manutenção sobrevive ao chamado.
  chamadoId   String?
  chamado     Chamado? @relation(fields: [chamadoId], references: [id], onDelete: SetNull)

  abertaEm     DateTime  @default(now())
  concluidaEm  DateTime? // null = ainda no conserto
  observacoes  String?

  @@index([computadorId])
  @@index([celularId])
  @@index([chamadoId])
  @@index([concluidaEm])
}

// Catálogo EDITÁVEL de tipos de componente (CPU, RAM, SSD, GPU, Monitor...).
// Permite adicionar tipos novos sem mexer no código.
model TipoComponente {
  id          String       @id @default(cuid())
  nome        String       @unique
  componentes Componente[]
}

model Componente {
  id             String         @id @default(cuid())
  computadorId   String
  computador     Computador     @relation(fields: [computadorId], references: [id], onDelete: Cascade)
  tipoId         String
  tipo           TipoComponente @relation(fields: [tipoId], references: [id])
  descricao      String // ex: "Kingston 8GB DDR4 2666MHz"
  // Campos livres adicionais (capacidade, modelo...) — mantém flexível.
  // SQLite não suporta o tipo Json no Prisma; guardamos JSON serializado em
  // texto e (de)serializamos na camada de API. Ver /docs/decisoes.md.
  especificacoes String? // JSON serializado
  criadoEm       DateTime       @default(now())

  // Índices das FKs (lookups por computador e por tipo, e checagem "tipo em uso").
  @@index([computadorId])
  @@index([tipoId])
}

// Trilha de auditoria: registra as alterações (quem/o quê/quando) feitas pela
// API. É um log append-only e independente das entidades (sem FK), para o
// histórico sobreviver mesmo que o registro de origem seja removido.
model LogAuditoria {
  id         String   @id @default(cuid())
  criadoEm   DateTime @default(now())
  acao       String // "criar" | "editar" | "remover" | "mover"
  entidade   String // "Computador" | "Componente" | "Funcionario" | "TipoComponente"
  entidadeId String? // id do registro afetado (null se já não existir)
  descricao  String // texto legível, ex: 'Computador "PAT-1001" criado'
  ator       String? // usuário responsável quando a auth Basic está ligada; senão null

  @@index([criadoEm])
  @@index([entidade])
}
