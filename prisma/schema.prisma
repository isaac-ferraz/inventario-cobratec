// Schema do Sistema de Inventário de Hardware (Cobratec TI)
// SQLite é a fonte única de verdade. O Excel é apenas relatório de saída.

generator client {
  provider = "prisma-client-js"
  // "native" cobre o ambiente local; o target musl cobre a imagem Alpine do Docker.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Funcionário = a pessoa dona do computador (operadora, gestor, supervisor, etc.)
model Funcionario {
  id            String       @id @default(cuid())
  nome          String
  cargo         String // texto livre p/ não engessar a lista de cargos
  ativo         Boolean      @default(true)
  // Credenciais dos sistemas usados pelo funcionário (substituem a matrícula).
  loginSiscobra String? // login do funcionário no sistema Siscobra
  senhaSiscobra String? // senha do funcionário no Siscobra
  loginVonix    String? // login do funcionário no Vonix
  senhaVonix    String? // senha do funcionário no Vonix
  computadores  Computador[]
  criadoEm      DateTime     @default(now())
}

model Computador {
  id            String       @id @default(cuid())
  identificador String       @unique // patrimônio, hostname ou etiqueta
  apelido       String?
  observacoes   String?
  // Login/licenças/conta da máquina — opcionais (nem todo PC tem tudo registrado)
  loginPadrao      String? // login padrão do computador, ex: "COB-1024"
  senha            String? // senha de acesso do computador
  licencaWindows   String? // chave/observação da licença do Windows
  licencaMicrosoft String? // licença Microsoft 365 / Office
  contaOutlook     String? // conta do Outlook corporativo (e-mail)
  // Periféricos: apenas presença (sem modelo). Mouse/teclado normalmente vêm
  // com a máquina; headset é o que mais varia.
  temMouse   Boolean @default(true)
  temTeclado Boolean @default(true)
  temHeadset Boolean @default(false)
  funcionarioId String?
  funcionario   Funcionario? @relation(fields: [funcionarioId], references: [id])
  componentes   Componente[]
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  // SQLite não cria índice de FK automaticamente; ajuda os filtros por dono.
  @@index([funcionarioId])
}

// Catálogo EDITÁVEL de tipos de componente (CPU, RAM, SSD, GPU, Monitor...).
// Permite adicionar tipos novos sem mexer no código.
model TipoComponente {
  id          String       @id @default(cuid())
  nome        String       @unique
  componentes Componente[]
}

model Componente {
  id             String         @id @default(cuid())
  computadorId   String
  computador     Computador     @relation(fields: [computadorId], references: [id], onDelete: Cascade)
  tipoId         String
  tipo           TipoComponente @relation(fields: [tipoId], references: [id])
  descricao      String // ex: "Kingston 8GB DDR4 2666MHz"
  // Campos livres adicionais (capacidade, modelo...) — mantém flexível.
  // SQLite não suporta o tipo Json no Prisma; guardamos JSON serializado em
  // texto e (de)serializamos na camada de API. Ver /docs/decisoes.md.
  especificacoes String? // JSON serializado
  criadoEm       DateTime       @default(now())

  // Índices das FKs (lookups por computador e por tipo, e checagem "tipo em uso").
  @@index([computadorId])
  @@index([tipoId])
}

// Trilha de auditoria: registra as alterações (quem/o quê/quando) feitas pela
// API. É um log append-only e independente das entidades (sem FK), para o
// histórico sobreviver mesmo que o registro de origem seja removido.
model LogAuditoria {
  id         String   @id @default(cuid())
  criadoEm   DateTime @default(now())
  acao       String // "criar" | "editar" | "remover" | "mover"
  entidade   String // "Computador" | "Componente" | "Funcionario" | "TipoComponente"
  entidadeId String? // id do registro afetado (null se já não existir)
  descricao  String // texto legível, ex: 'Computador "PAT-1001" criado'
  ator       String? // usuário responsável quando a auth Basic está ligada; senão null

  @@index([criadoEm])
  @@index([entidade])
}
