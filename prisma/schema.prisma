// Schema do Sistema de Inventário de Hardware (Cobratec TI)
// SQLite é a fonte única de verdade. O Excel é apenas relatório de saída.

generator client {
  provider = "prisma-client-js"
  // "native" cobre o ambiente local; o target musl cobre a imagem Alpine do Docker.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Sala = espaço físico do escritório (ex: "Sala 93 — piso superior"). É um
// catálogo EDITÁVEL pela UI, no mesmo espírito do TipoComponente: o TI cadastra
// salas novas sem mexer no código. Liga-se ao computador (onde a máquina está) e
// ao funcionário (onde a pessoa senta). Celular não tem sala: o aparelho anda
// com o dono. Ver /docs/decisoes.md.
model Sala {
  id           String        @id @default(cuid())
  nome         String        @unique // "Sala 93 — piso superior"
  predio       String? // "93", "83"... texto livre
  piso         String? // "superior", "inferior", "térreo"... texto livre
  ordem        Int           @default(0) // ordem de exibição nas listas
  ativa        Boolean       @default(true) // sala desativada some dos seletores
  observacoes  String?
  computadores Computador[]
  funcionarios Funcionario[]
  chamados     Chamado[]
  criadoEm     DateTime      @default(now())
}

// Usuário = quem ENTRA no sistema. Tabela separada do Funcionario de propósito:
// o funcionário é um registro de inventário (dono de equipamento, com as
// credenciais Siscobra/Vonix guardadas como cofre); o usuário é acesso ao app.
// Nem todo funcionário precisa de login, e o TI pode ter login sem estar no
// inventário. O vínculo é opcional, para o chamado saber de quem é o posto.
//
// papel: "ADMIN" (acesso total) | "OPERADOR" (só abre e acompanha chamados).
// Guardado como String, no mesmo espírito de `cargo`/`categoria` — o SQLite não
// tem enum nativo e a lista é curta e estável.
model Usuario {
  id             String       @id @default(cuid())
  login          String       @unique
  nome           String
  // Hash scrypt no formato "scrypt$N$salt$hash" — ver lib/senha.ts. Diferente
  // das senhas do cofre (Siscobra/Vonix/PC), que são texto puro por precisarem
  // ser LIDAS de volta; esta aqui só precisa ser comparada.
  senhaHash      String
  papel          String       @default("OPERADOR")
  ativo          Boolean      @default(true)
  // Marca a senha inicial gerada pelo seed: a UI cobra a troca até ser mudada.
  senhaProvisoria Boolean     @default(false)
  funcionarioId  String?
  funcionario    Funcionario? @relation(fields: [funcionarioId], references: [id])
  criadoEm       DateTime     @default(now())
  ultimoAcessoEm DateTime?

  chamadosAbertos    Chamado[]         @relation("solicitante")
  chamadosAtribuidos Chamado[]         @relation("responsavel")
  mensagens          ChamadoMensagem[]

  @@index([funcionarioId])
}

// Chamado = pedido de suporte ao TI. É a única coisa que o OPERADOR faz no
// sistema; o admin recebe, assume, responde e fecha.
//
// status:     aberto | em_andamento | aguardando | resolvido | fechado
// prioridade: baixa | normal | alta | urgente
// Guardados como String pelo mesmo motivo de `papel` e `cargo`: SQLite não tem
// enum nativo e a lista é curta e estável.
model Chamado {
  id     String @id @default(cuid())
  // Número curto para as pessoas se referirem ao chamado ("o #12"). O SQLite só
  // aceita autoincrement na PK, então é calculado como max+1 dentro da
  // transação de criação (escrita serializada; volume de um escritório).
  numero Int    @unique

  titulo     String
  descricao  String
  categoria  String? // texto livre com sugestões na UI
  prioridade String  @default("normal")
  status     String  @default("aberto")

  // Quem pediu. Sempre vem da sessão, nunca do corpo da requisição.
  solicitanteId String
  solicitante   Usuario @relation("solicitante", fields: [solicitanteId], references: [id])
  // Admin que assumiu (opcional: chamado pode estar sem dono ainda).
  responsavelId String?
  responsavel   Usuario? @relation("responsavel", fields: [responsavelId], references: [id])

  // Contexto do problema — todos opcionais. `onDelete: SetNull` porque o
  // histórico do chamado deve sobreviver ao descarte do equipamento.
  computadorId String?
  computador   Computador? @relation(fields: [computadorId], references: [id], onDelete: SetNull)
  celularId    String?
  celular      Celular?    @relation(fields: [celularId], references: [id], onDelete: SetNull)
  salaId       String?
  sala         Sala?       @relation(fields: [salaId], references: [id], onDelete: SetNull)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  resolvidoEm  DateTime?

  mensagens   ChamadoMensagem[]
  manutencoes Manutencao[]

  @@index([status])
  @@index([solicitanteId])
  @@index([responsavelId])
  @@index([criadoEm])
}

// Andamento do chamado. `interna = true` marca nota do TI: aparece só para
// administradores e é filtrada na API antes de sair — o operador nunca a recebe.
model ChamadoMensagem {
  id        String   @id @default(cuid())
  chamadoId String
  chamado   Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  autorId   String
  autor     Usuario  @relation(fields: [autorId], references: [id])
  corpo     String
  interna   Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([chamadoId, criadoEm])
  @@index([autorId])
}

// Funcionário = a pessoa dona do computador (operadora, gestor, supervisor, etc.)
model Funcionario {
  id            String       @id @default(cuid())
  nome          String
  cargo         String // texto livre p/ não engessar a lista de cargos
  ativo         Boolean      @default(true)
  salaId        String? // onde a pessoa senta (null = sem sala definida)
  sala          Sala?        @relation(fields: [salaId], references: [id])
  // Credenciais dos sistemas usados pelo funcionário (substituem a matrícula).
  loginSiscobra String? // login do funcionário no sistema Siscobra
  senhaSiscobra String? // senha do funcionário no Siscobra
  loginVonix    String? // login do funcionário no Vonix
  senhaVonix    String? // senha do funcionário no Vonix
  computadores  Computador[]
  celulares     Celular[]
  usuarios      Usuario[]
  criadoEm      DateTime     @default(now())

  // SQLite não cria índice de FK automaticamente; ajuda o filtro por sala.
  @@index([salaId])
}

// Celular = aparelho corporativo. Igual ao Computador, pertence a um funcionário
// (ou fica em estoque com funcionarioId null) e pode ser movido entre eles.
// Não tem componentes/hardware — campos próprios de telefonia.
model Celular {
  id            String       @id @default(cuid())
  identificador String       @unique // patrimônio, etiqueta ou IMEI
  apelido       String? // modelo, ex: "Samsung Galaxy A14"
  numero        String? // número da linha, ex: "(11) 99999-0000"
  operadora     String? // Vivo, Claro, Tim... texto livre
  imei          String? // IMEI do aparelho
  observacoes   String?
  // --- Ciclo de vida do ativo (decisão 21) ---
  // `situacao` é o estado do EQUIPAMENTO, independente de ter dono: uma máquina
  // pode estar em manutenção e continuar atribuída a alguém.
  // ativo | manutencao | reserva | descartado
  situacao      String       @default("ativo")
  dataAquisicao DateTime?
  notaFiscal    String?
  garantiaAte   DateTime?
  valorCompra   Float?
  funcionarioId String?
  funcionario   Funcionario? @relation(fields: [funcionarioId], references: [id])
  chamados      Chamado[]
  manutencoes   Manutencao[]
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  // SQLite não cria índice de FK automaticamente; ajuda os filtros por dono.
  @@index([funcionarioId])
  @@index([situacao])
}

model Computador {
  id            String       @id @default(cuid())
  identificador String       @unique // patrimônio, hostname ou etiqueta
  apelido       String?
  observacoes   String?
  // Login/licenças/conta da máquina — opcionais (nem todo PC tem tudo registrado)
  loginPadrao      String? // login padrão do computador, ex: "COB-1024"
  senha            String? // senha de acesso do computador
  licencaWindows   String? // chave/observação da licença do Windows
  licencaMicrosoft String? // licença Microsoft 365 / Office
  contaOutlook     String? // conta do Outlook corporativo (e-mail)
  // Periféricos: apenas presença (sem modelo). Mouse/teclado normalmente vêm
  // com a máquina; headset é o que mais varia.
  temMouse   Boolean @default(true)
  temTeclado Boolean @default(true)
  temHeadset Boolean @default(false)

  // --- Ciclo de vida do ativo (decisão 21) ---
  // `situacao` é o estado do EQUIPAMENTO, independente de ter dono: uma máquina
  // pode estar em manutenção e continuar atribuída a alguém.
  // ativo | manutencao | reserva | descartado
  situacao      String       @default("ativo")
  dataAquisicao DateTime?
  notaFiscal    String?
  garantiaAte   DateTime?
  valorCompra   Float?
  funcionarioId String?
  funcionario   Funcionario? @relation(fields: [funcionarioId], references: [id])
  // Onde a máquina está fisicamente. Independe do dono: um PC em estoque
  // continua ocupando uma sala.
  salaId        String?
  sala          Sala?        @relation(fields: [salaId], references: [id])
  componentes   Componente[]
  chamados      Chamado[]
  manutencoes   Manutencao[]
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  // SQLite não cria índice de FK automaticamente; ajuda os filtros por dono/sala.
  @@index([funcionarioId])
  @@index([salaId])
  @@index([situacao])
}

// Item do depósito = suprimento avulso guardado em caixas (cabos, mouses,
// adaptadores, pilhas, etc.). É um controle de ESTOQUE por quantidade — quanto
// se tem de cada item e o que está em falta. Independente de computador/celular.
model ItemDeposito {
  id               String   @id @default(cuid())
  nome             String // ex: "Cabo HDMI 2m", "Mouse USB"
  categoria        String? // texto livre p/ não engessar: "Cabos", "Periféricos"...
  quantidade       Int      @default(0) // quantas unidades existem
  quantidadeMinima Int      @default(0) // alerta de estoque baixo (0 = sem alerta)
  localizacao      String? // onde está guardado, ex: "Caixa 3", "Prateleira A"
  observacoes      String?
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  @@index([categoria])
}

// Manutenção = uma ida do equipamento para conserto ou revisão. É um EVENTO com
// começo e fim, não um estado — o estado fica em `Computador.situacao` /
// `Celular.situacao`. Separar os dois permite ter histórico ("já foi 3 vezes
// para o conserto") sem perder a leitura rápida de onde a máquina está hoje.
model Manutencao {
  id           String      @id @default(cuid())
  // Um dos dois é preenchido (computador OU celular). A API valida isso; o
  // SQLite não tem CHECK constraint expressável no Prisma.
  computadorId String?
  computador   Computador? @relation(fields: [computadorId], references: [id], onDelete: Cascade)
  celularId    String?
  celular      Celular?    @relation(fields: [celularId], references: [id], onDelete: Cascade)

  tipo        String // "corretiva" (quebrou) | "preventiva" (revisão)
  descricao   String
  fornecedor  String? // assistência técnica, loja...
  custo       Float?
  // Chamado que originou o conserto, quando veio de um. Fecha o ciclo
  // suporte → manutenção. SetNull: a manutenção sobrevive ao chamado.
  chamadoId   String?
  chamado     Chamado? @relation(fields: [chamadoId], references: [id], onDelete: SetNull)

  abertaEm     DateTime  @default(now())
  concluidaEm  DateTime? // null = ainda no conserto
  observacoes  String?

  @@index([computadorId])
  @@index([celularId])
  @@index([chamadoId])
  @@index([concluidaEm])
}

// Catálogo EDITÁVEL de tipos de componente (CPU, RAM, SSD, GPU, Monitor...).
// Permite adicionar tipos novos sem mexer no código.
model TipoComponente {
  id          String       @id @default(cuid())
  nome        String       @unique
  componentes Componente[]
}

model Componente {
  id             String         @id @default(cuid())
  computadorId   String
  computador     Computador     @relation(fields: [computadorId], references: [id], onDelete: Cascade)
  tipoId         String
  tipo           TipoComponente @relation(fields: [tipoId], references: [id])
  descricao      String // ex: "Kingston 8GB DDR4 2666MHz"
  // Campos livres adicionais (capacidade, modelo...) — mantém flexível.
  // SQLite não suporta o tipo Json no Prisma; guardamos JSON serializado em
  // texto e (de)serializamos na camada de API. Ver /docs/decisoes.md.
  especificacoes String? // JSON serializado
  criadoEm       DateTime       @default(now())

  // Índices das FKs (lookups por computador e por tipo, e checagem "tipo em uso").
  @@index([computadorId])
  @@index([tipoId])
}

// Trilha de auditoria: registra as alterações (quem/o quê/quando) feitas pela
// API. É um log append-only e independente das entidades (sem FK), para o
// histórico sobreviver mesmo que o registro de origem seja removido.
model LogAuditoria {
  id         String   @id @default(cuid())
  criadoEm   DateTime @default(now())
  acao       String // "criar" | "editar" | "remover" | "mover"
  entidade   String // "Computador" | "Componente" | "Funcionario" | "TipoComponente"
  entidadeId String? // id do registro afetado (null se já não existir)
  descricao  String // texto legível, ex: 'Computador "PAT-1001" criado'
  ator       String? // usuário responsável quando a auth Basic está ligada; senão null

  @@index([criadoEm])
  @@index([entidade])
}
