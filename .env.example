# Copie para `.env` e ajuste. O `.env` real NÃO vai pro git (.gitignore).

# Banco SQLite. Em desenvolvimento, arquivo local na pasta prisma.
# No Docker, o entrypoint usa file:/app/data/dev.db (volume persistente).
DATABASE_URL="file:./dev.db"

